# ---- API keys you provide ----
GEMINI_API_KEY=your-gemini-api-key

# ---- Supabase (project "image") ----
SUPABASE_URL=https://tvbvjzvvkzznnhoepfyb.supabase.co
# Service-role key: Supabase dashboard -> Project Settings -> API -> service_role.
# Server-side only. Bypasses RLS. Never expose it in a browser/client.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_PROJECT_ID=tvbvjzvvkzznnhoepfyb

# ---- Models & retrieval config ----
EMBED_MODEL=gemini-embedding-2-preview
# Reasoning runs on a local Ollama model (no external API / billing).
# Install Ollama (https://ollama.com) and run: ollama pull gemma3:4b
OLLAMA_MODEL=gemma3:4b
OLLAMA_HOST=http://localhost:11434
EMBED_DIM=1536
STORAGE_BUCKET=documents
MATCH_COUNT=5
